# --- WPHub SaaS Cloud Environment Configuration ---
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/wphub_db?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO / S3 alternative)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_secret
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET_NAME=wphub-wordpress-backups

# Traefik Router Settings (Cloud load balancing setup)
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_HTTP_PORT=80
